{
  "name": "chert-video-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "precheck": "node --check outbound.mjs",
    "start": "node --env-file=.env.local agent.mjs start",
    "check": "node --check chert-rooms.mjs && node --check agent.mjs && node --check face.mjs && node --check greet.mjs && node --check vision.mjs && node --check armory.mjs && node --check forge-test.mjs",
    "help": "node agent.mjs --help",
    "armory": "node --env-file=../../forge/.env.local armory.mjs",
    "forge-test": "node --env-file=.env.local forge-test.mjs"
  },
  "dependencies": {
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-google": "^1.8.0",
    "@livekit/agents-plugin-openai": "1.8.0",
    "@livekit/rtc-node": "0.13.35",
    "livekit-server-sdk": "^2.19.3",
    "sharp": "^0.34.5",
    "ws": "^8.23.0"
  }
}
