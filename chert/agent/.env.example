# Fill these in privately in .env.local. Never commit .env.local.

# All three LiveKit values must belong to one project.
# For inbound calls on a Shared plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
# outbound.mjs always needs all three.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# A Gemini API key. It runs the voice (Gemini Live) and the object finder (VISION_MODEL).
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
# Optional. The model that names the held-up object. Default: gemini-2.5-flash.
# VISION_MODEL=gemini-2.5-flash

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=YOUR_AGENT_NAME

# Only for outbound.mjs (one outbound FaceTime Video call).
CHERT_API_KEY=YOUR_CHERT_API_KEY
CHERT_PROJECT_ID=YOUR_CHERT_PROJECT_ID
CHERT_LINE_ID=YOUR_CHERT_LINE_ID
# The phone number to call, in E.164 form.
OUTBOUND_TO=+15555550123
# Optional. Default: https://facetime.trychert.com/api/v1
# CHERT_API_BASE=
