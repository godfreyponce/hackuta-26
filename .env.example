# ── Server (D) ──
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
MONGODB_URI=                      # Atlas SRV string
MONGODB_DB=ithaca
AGENT_SHARED_SECRET=              # random string; agent uses it to auth the WS
CORS_ORIGIN=http://localhost:5173

# Vision — Claude now, Gemini at the end
VISION_PROVIDER=claude            # claude | gemini | mock
ANTHROPIC_API_KEY=
VISION_MODEL=                     # set to a current Claude vision-capable model ID
GEMINI_API_KEY=
GEMINI_VISION_MODEL=              # set to a current Gemini vision model ID when switching

# 3D generation
MODEL3D_PROVIDER=stability        # stability | prefab
STABILITY_API_KEY=
SF3D_TEXTURE_RES=512              # 512 | 1024 | 2048
SF3D_TIMEOUT_MS=15000
FORGE_CLEAN_IMAGE=0               # 1 = redraw object w/o hand via SD3.5 before 3D (+3.5s, +4 credits)
FORGE_3D_MODEL=fast               # fast (stable-fast-3d) | spar (stable-point-aware-3d)

# ── LiveKit (D mints game tokens, B mints FaceTime-room tokens) ──
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Agent (B) ──
SERVER_WS_URL=ws://localhost:8787/ws
SERVER_HTTP_URL=http://localhost:8787
AGENT_MODE=live                   # live | mock-call (no Chert; use dev fake-phone page)
CHERT_API_BASE=https://facetime.trychert.com/api/v1
CHERT_FACETIME_TOKEN=             # ftk_… project key (scopes facetime:write, facetime:read)
CHERT_PROJECT_ID=
CHERT_LINE_ID=
CALL_MAX_MS=285000                # hard stop at 4:45 (free/shared tier = 5 min per call)
CALLER_CROP=0.08,0.12,0.92,0.88   # x0,y0,x1,y1 normalized crop of caller video
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ── Web (A) — only VITE_ vars reach the browser; NO secrets here ──
VITE_MOCK_SERVER=0
VITE_INPUT=motion                 # motion | keyboard_mouse | replay
